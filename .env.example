# Copy to .env for local runs. On Streamlit Cloud use App settings > Secrets instead.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDERS=gemini,ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
# 1 = call linters through the MCP server (stdio), 0 = call them directly
USE_MCP=1
