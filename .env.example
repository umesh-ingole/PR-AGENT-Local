# Copy to .env for local runs. On Streamlit Cloud use App settings > Secrets instead.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDERS=gemini,ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
# MCP is optional and unreliable on Windows; 1 enables MCP, 0 calls linters directly
USE_MCP=0
